datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          String         @default("STUDENT") // STUDENT, DOCTOR, TA, ADMIN
  status        String         @default("PENDING") // PENDING, ACTIVE, REJECTED, SUSPENDED
  avatarUrl     String?
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?

  postsCreated     Post[]
  commentsMade     Comment[]
  reactionsGiven   Reaction[]
  notifications    Notification[]
  auditLogs        AuditLog[]        @relation("ActorAuditLogs")
  targetAuditLogs  AuditLog[]        @relation("TargetAuditLogs")
  
  // Faculty subjects
  subjectsAsDoctor Subject[]         @relation("DoctorSubjects")
  subjectsAsTA     Subject[]         @relation("TASubjects")

  // Schedules
  doctorSchedules  Schedule[]        @relation("DoctorSchedules")
  taSchedules      Schedule[]        @relation("TASchedules")

  // Attendance
  sessionsCreated  AttendanceSession[] @relation("SessionCreator")
  attendanceRecords AttendanceRecord[]
  
  resetTokens      PasswordResetToken[]

  @@index([role])
  @@index([status])
}

model StudentProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId      String       @unique // e.g. 20241001
  universityCode String       @unique // e.g. CSI-ST-1001
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gpa            Float        @default(0.0)
  totalCredits   Int          @default(0)
  nationalId     String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([academicYearId])
}

model FacultyProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?  // e.g. "أستاذ دكتور", "مدرس", "معيد"
  officeRoom  String?
  bio         String?
  specialty   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id               String       @id @default(cuid())
  name             String       @unique // e.g. "علوم الحاسب"
  code             String       @unique // e.g. "CS"
  description      String?
  headOfDepartment String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users            User[]
  subjects         Subject[]
  schedules        Schedule[]
}

model AcademicYear {
  id          String           @id @default(cuid())
  name        String           @unique // e.g. "الفرقة الأولى"
  code        String           @unique // e.g. "YEAR_1"
  level       Int              @unique // 1, 2, 3, 4
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  students    StudentProfile[]
  subjects    Subject[]
  schedules   Schedule[]
  sessions    AttendanceSession[]
}

model Subject {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique // e.g. "CS101"
  description    String?
  creditHours    Int             @default(3)
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  doctorId       String?
  doctor         User?           @relation("DoctorSubjects", fields: [doctorId], references: [id], onDelete: SetNull)
  taId           String?
  ta             User?           @relation("TASubjects", fields: [taId], references: [id], onDelete: SetNull)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  schedules      Schedule[]
  sessions       AttendanceSession[]
  posts          Post[]

  @@index([departmentId])
  @@index([academicYearId])
}

model Schedule {
  id             String       @id @default(cuid())
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  doctorId       String?
  doctor         User?        @relation("DoctorSchedules", fields: [doctorId], references: [id], onDelete: SetNull)
  taId           String?
  ta             User?        @relation("TASchedules", fields: [taId], references: [id], onDelete: SetNull)

  dayOfWeek      String       // Saturday, Sunday, Monday, Tuesday, Wednesday, Thursday
  startTime      String       // "09:00"
  endTime        String       // "10:30"
  room           String       // "مدرج 1", "معمل 3"
  type           String       @default("LECTURE") // LECTURE, SECTION, LAB

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([academicYearId])
  @@index([departmentId])
  @@index([subjectId])
}

model AttendanceSession {
  id              String            @id @default(cuid())
  subjectId       String
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         User              @relation("SessionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  sessionDate     DateTime          @default(now())
  startTime       DateTime          @default(now())
  expiresAt       DateTime
  durationMinutes Int               @default(5)
  sessionToken    String            @unique
  isActive        Boolean           @default(true)
  room            String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  records         AttendanceRecord[]

  @@index([subjectId])
  @@index([creatorId])
  @@index([sessionToken])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedAt  DateTime         @default(now())
  status    String           @default("PRESENT") // PRESENT, LATE, EXCUSED
  ipAddress String?
  deviceInfo String?

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
}

model Post {
  id            String       @id @default(cuid())
  authorId      String
  author        User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subjectId     String?
  subject       Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title         String?
  content       String
  linkUrl       String?
  imageUrl      String?
  isPinned      Boolean      @default(false)
  allowComments Boolean      @default(true)
  allowReactions Boolean     @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  comments      Comment[]
  reactions     Reaction[]
  media         PostMedia[]

  @@index([authorId])
  @@index([subjectId])
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  mediaType String   @default("image") // image, document, link
  fileName  String?
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model Reaction {
  id        String       @id @default(cuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String       @default("LIKE") // LIKE, HEART, CLAP, INSIGHTFUL
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String           @default("SYSTEM") // ATTENDANCE, APPROVAL, ACADEMIC, SYSTEM
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

model SiteSettings {
  id                 String   @id @default("default")
  instituteName      String   @default("المعهد العالي لعلوم الحاسب ونظم المعلومات - مدينة الثقافة والعلوم")
  shortName          String   @default("CSI Computer Science Institute")
  logoUrl            String   @default("/logo.png")
  faviconUrl         String   @default("/favicon.ico")
  description        String   @default("بوابة المعهد العالي لعلوم الحاسب ونظم المعلومات بمدينة الثقافة والعلوم بالسادس من أكتوبر")
  contactPhone       String   @default("02-38350000")
  contactEmail       String   @default("info@csi.edu.eg")
  address            String   @default("مدينة الثقافة والعلوم، الحي الأول، السادس من أكتوبر، الجيزة، مصر")
  facebookUrl        String?  @default("https://facebook.com")
  twitterUrl         String?
  linkedinUrl        String?
  heroTitle          String   @default("مستقبلك يبدأ من هنا")
  heroSubtitle       String   @default("المعهد العالي لعلوم الحاسب ونظم المعلومات — صرح أكاديمي رائد لإعداد مهندسي ومطوري المستقبل")
  heroImageUrl       String?
  primaryColor       String   @default("#f59e0b")
  secondaryColor     String   @default("#0f172a")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String   @default("نقوم حالياً بإجراء بعض التحديثات وأعمال الصيانة لتحسين وتطوير تجربة البوابة الأكاديمية. سنعود قريباً.")
  estimatedEndTime   String?
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  targetId   String?
  target     User?    @relation("TargetAuditLogs", fields: [targetId], references: [id], onDelete: SetNull)
  action     String   // e.g. "USER_APPROVAL", "GPA_UPDATE", "MAINTENANCE_TOGGLE", "SESSION_CREATE"
  targetType String   // USER, SUBJECT, SCHEDULE, SETTINGS, ATTENDANCE
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}
